# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성)
# 비워두면 "체험 모드"로 실행되어 이 기기 브라우저에만 저장됩니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps JavaScript API 키 (Maps JavaScript API + Places API (New) 사용 설정 필요)
# 비워두면 지도/장소 검색 대신 직접 입력 + 구글 지도 링크로 동작합니다.
VITE_GOOGLE_MAPS_API_KEY=
# 지도 ID (Google Cloud 콘솔 > 지도 관리). 비워두면 DEMO_MAP_ID 사용
VITE_GOOGLE_MAPS_MAP_ID=
