rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isMember(trip) {
      return signedIn() && myEmail() in trip.memberEmails;
    }

    // 여행: 초대된 이메일(memberEmails)에 들어있는 사람만 읽고 쓸 수 있음
    match /trips/{tripId} {
      allow read: if isMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && myEmail() in request.resource.data.memberEmails;
      // 만든 사람 정보는 바꿀 수 없고, 만든 사람은 멤버에서 빠질 수 없음
      allow update: if isMember(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && resource.data.ownerEmail in request.resource.data.memberEmails;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // 장소(places), 지출(expenses), 날짜별 기록(notes)
      match /{sub}/{docId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
      }
    }
  }
}
